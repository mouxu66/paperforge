# ==================== 运行时开关 ====================
# 是否启用前端模型切换功能
MODEL_SWITCH_ENABLED=true
# development 时才允许调用打包接口；生产环境设为 production
ENV=development

# ==================== 启动器（mock_api/launcher.py） ====================
# 后端端口覆盖（默认自动探测 8770-8774）
# PAPERFORGE_PORT_OVERRIDE=8770
# 是否自动打开浏览器（standalone 模式默认 1，开发模式由 start_paperforge.bat 设为 0）
# PAPERFORGE_LAUNCHER_AUTOBROWSER=1
# 前端静态产物目录（standalone 模式 serve dist 用，默认 web/dist）
# PAPERFORGE_WEB_DIST=web/dist

# 说明：LLM 模型配置（API 地址 / API Key / 模型 ID）已迁移至数据库 llm_configs 表，
# 请在前端「模型管理」页面添加，不再通过 .env 配置。
