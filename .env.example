# ==================== 运行时开关 ====================
# 是否启用前端模型切换功能
MODEL_SWITCH_ENABLED=true
# development 时才允许调用打包接口；生产环境设为 production
ENV=development

# ==================== 启动器（mock_api/launcher.py） ====================
# 后端端口覆盖（默认自动探测 8770-8774）
# PAPERFORGE_PORT_OVERRIDE=8770
# 是否自动打开浏览器（standalone 模式默认 1，开发模式由 start_paperforge.bat 设为 0）
# PAPERFORGE_LAUNCHER_AUTOBROWSER=1
# 前端静态产物目录（standalone 模式 serve dist 用，默认 web/dist）
# PAPERFORGE_WEB_DIST=web/dist

# 跳过前端自动构建（设为 1 禁止启动时自动 npm install + npm run build）
# PAPERFORGE_NO_AUTO_REBUILD=0

# ==================== 服务绑定（Layer 0：部署配置） ====================
# 后端监听地址：默认 127.0.0.1（仅本机）；设 0.0.0.0 可对外暴露（API 模式必须）
# ⚠️ 安全提示：设为 0.0.0.0 后请务必配置 PAPERFORGE_API_TOKEN 或启用多 API Key
# PAPERFORGE_BIND_HOST=127.0.0.1
# 后端监听端口（默认 8770；launcher 会在此端口基础上自动探测空闲端口）
# 纯 API 模式（scripts/serve_api.py）直接使用此端口，不会自动探测
# PAPERFORGE_BIND_PORT=8770

# ==================== API 鉴权（Layer 1：多 API Key） ====================
# 全局 API Token（向后兼容）：非空时所有写操作需带 X-PaperForge-Token 头
# 配置后此 token 视为超级管理员，拥有所有 scope（read/write/admin）
# 推荐生产环境必配，否则只能通过多 API Key 系统授权外部调用方
# PAPERFORGE_API_TOKEN=
# 放宽 loopback 限制：设为 1 允许非本机访问（对外 API 模式必须开启）
# ⚠️ 安全提示：开启后若未配置 PAPERFORGE_API_TOKEN 且未创建任何 API Key，
#     系统将等价于完全开放（向后兼容旧行为），仅在内网受信任环境使用
# PAPERFORGE_ALLOW_REMOTE=0
# 可信反向代理 IP 列表（JSON 数组，如 ["127.0.0.1","10.0.0.5"]）。
# 非空且请求直连来源在列表内时，才采信 X-Forwarded-For 头首项作为客户端 IP
# （open 模式按 IP 限流用）；为空（默认）一律不采信 XFF，以直连 socket 地址
# 为准，防止客户端伪造 XFF 绕过限流。
# PAPERFORGE_TRUSTED_PROXIES=[]
# 是否启用鉴权（默认 True；仅调试场景设为 0 关闭全部鉴权）
# PAPERFORGE_AUTH_ENABLED=true
# 是否启用 admin 端点（默认 False；设为 development 时才允许调用打包接口等高危端点）
# ENV=production
# admin 端点开关：默认 False，仅在 ENV=development 时可用
# PAPERFORGE_BUILD_ALLOWED=false

# ==================== API 限流 / 审计（Layer 2） ====================
# 每个 API Key 默认速率上限（请求/分钟）。0=不限流。
# 创建 API Key 时若未显式指定 rateLimitPerMin，则使用此默认值。
# 超级管理员（全局 token / loopback 免鉴权）不受限流影响。
# PAPERFORGE_API_KEY_RATE_LIMIT_DEFAULT=60
# 是否记录 API 调用审计日志到 api_call_logs 表（默认 True）
# 关闭后可减少数据库写入，但会丢失调用追踪与用量统计能力
# PAPERFORGE_API_KEY_AUDIT_ENABLED=true

# 说明：LLM 模型配置（API 地址 / API Key / 模型 ID）已迁移至数据库 llm_configs 表，
# 请在前端「模型管理」页面添加，不再通过 .env 配置。

# ==================== 算力模式 ====================
# 默认算力模式: speed / deep，默认 deep
# COMPUTE_MODE=deep
# 动态资源检测开关（Windows 上默认禁用，设为 1 启用）
# ⚠️ 警告：Windows 应用商店版 Python 3.13 启用此开关可能触发 C 级进程崩溃（access violation）。
# 建议改用 python.org 标准安装，或保持检测关闭。
# PAPERFORGE_ENABLE_RESOURCE_DETECT=0
# 禁用资源检测
# PAPERFORGE_DISABLE_RESOURCE_DETECT=1

# ==================== LLM Provider ====================
# HTTP 请求超时秒数，默认 120
# PAPERFORGE_PROVIDER_TIMEOUT=120
# LLM 缓存 TTL 秒数，0=禁用，默认 300
# PAPERFORGE_LLM_CACHE_TTL=300
# Reflection 评审 max_tokens 下限，默认 3000
# REFLECTION_MAX_TOKENS=3000

# ==================== 批量任务 ====================
# DEPTH 批量评估并发数
# PAPERFORGE_BATCH_PARALLEL=4

# ==================== arXiv ====================
# 自动拉取开关
# ARXIV_AUTO_FETCH_ENABLED=true
# 每次拉取最大条数
# ARXIV_AUTO_FETCH_MAX_RESULTS=5

# ==================== 多语言嵌入模型 ====================
# 本地 ONNX 兜底：设为 1 跳过 fastembed 的 HF Hub API 握手，
# 直读 mock_api/_models/paraphrase-multilingual-onnx/（沙箱/离线环境用）
# PAPERFORGE_LOCAL_ML=1

# ==================== 数据库 ====================
# 数据库文件路径
# PAPERFORGE_DB_PATH=mock_api/paperforge_mock.db

# ==================== 本地 llama.cpp OCR（PaddleOCR-VL）====================
# D1 分发陷阱：以下路径在开发机 .env 中使用绝对路径（如 C:/Users/.../PaddleOCR-VL-*.gguf），
# 分发到目标机时该路径不存在 -> pdf_parser 优雅 RETURN_NONE -> 扫描 PDF 拿不到 OCR 文本但不报错，
# 功能无声退化为空。分发构建时须：
#   (1) 随附 GGUF 模型文件并改为相对路径（如 ./models/PaddleOCR-VL-1.6-GGUF.gguf）；
#   (2) 或设 LLAMA_CPP_ENABLED=False 禁用本地 OCR。
# LLAMA_CPP_OCR_MODEL_PATH=./models/PaddleOCR-VL-1.6-GGUF.gguf
# LLAMA_CPP_OCR_MMPROJ_PATH=./models/PaddleOCR-VL-1.6-GGUF-mmproj.gguf
# LLAMA_CPP_ENABLED=False

# ==================== arXiv 限速（N3）====================
# resolve_and_ingest 在检索 arXiv 前的礼貌限速秒数（默认 3.0）。
# 设为 0 可跳过限速（本地/测试环境），减少交互式上传延迟。
# PAPERFORGE_ARXIV_RATE_LIMIT_SEC=3.0

# ==================== 关键功能开关（P0 文档债补全 · 2026-07-30） ====================
# 以下开关对应 PaperForge 的核心行为与学术诚信护栏，原 .env.example 缺失。
# 变量名与默认值均对照 mock_api/settings.py 与对应模块核实；详见 docs/adr/。

# ── figure-trigger 铁律（ADR-010）──
# 批量 DEPTH 评估时是否禁用 figure 视觉 pass（=1 禁用，figure 改作 bulk 之外的独立 pass）。
# 原始用途：避免 worker 内 PaddleOCR-VL 与 Qwen 互斥 segfault 拖垮批量评估。
# 2026-07-27 OCR 退役后根因已消失，是否仍需强制禁用待重评（见 ADR-010）。
# 默认：未设置（0 / 关闭，即允许 figure-trigger）。
# PAPERFORGE_DISABLE_FIGURE_TRIGGER=1

# ── invalid gate 降级开关（DEPTH v4.2）──
# DEPTH 审阅判定为「无效」时是否降级回旧逻辑（=1 切回旧逻辑，不抛异常、直接返回 record_id）。
# 用于审阅流水线异常时瞬间止血；默认关闭（走新校验逻辑）。
# 默认：未设置（0 / 关闭）。
# PAPERFORGE_DISABLE_INVALID_GATE=1

# ── 视觉模型 HTTP 端点（Qwen3-VL-4B，2026-07-26 启用，替代进程内 PaddleOCR-VL）──
# figure_qwen 走此 HTTP 端点做多模态视觉理解（推荐端口 8082）。设置后不再依赖进程内 llama_cpp。
# 也接受别名 VISION_HTTP_URL。默认：未设置（None，figure 视觉能力关闭）。
# PAPERFORGE_VISION_HTTP_URL=http://127.0.0.1:8082
# ⚠️ 安全：vision llama-server 是外部进程、无认证，启动命令须显式 --host 127.0.0.1
#   （llama.cpp 默认绑 0.0.0.0，会暴露无认证推理端点到同网段）。推荐启动命令：
#   llama-server -m Qwen3VL-4B-Instruct-Q4_K_M.gguf --mmproj mmproj-Qwen3VL-4B-Instruct-Q8_0.gguf --host 127.0.0.1 --port 8082 -ngl 35 -c 4096 --jinja
#   与文本 Qwen（llama_server_host 默认 127.0.0.1）形成一致安全基线。详见 RUNBOOK §6。

# ── 独立云端视觉后端（2026-08-16 新增，与本地 Qwen3-VL 解耦）──
# 云端视觉推理不占本地显存，不参与 text/vision 同卡互斥；默认关闭，仅作审计语义兜底
# （axis_info 为 None 时由 check_figure_axis_risks 调用）。上游由 PROVIDER 决定：
#   glm   = 智谱开放平台（默认；glm-4v-flash 等；/v4 路径；无需额外设 BASE_URL）
#   agnes = Agnes AI 官方 OpenAI 兼容视觉理解（apihub.agnes-ai.com/v1，模型 agnes-2.5-flash，
#           支持图片输入理解；Free 计划限速 20 RPM，内部按 ~3s/次节流）。
# 切换 agnes 时若未显式设 BASE_URL/MODEL，自动回落到 Agnes 默认端点与模型。
# 注意：glm_vision_api_key 为云端凭证，.env 已被 gitignore，切勿提交。
# PAPERFORGE_GLM_VISION_ENABLED=0
# PAPERFORGE_GLM_VISION_PROVIDER=glm
# PAPERFORGE_GLM_VISION_API_KEY=
# PAPERFORGE_GLM_VISION_MODEL=
# PAPERFORGE_GLM_VISION_BASE_URL=
# PAPERFORGE_GLM_VISION_MAX_CONCUR=4

# ── OCR HTTP 端点（⚠️ DEPRECATED：2026-07-27 后由 PAPERFORGE_VISION_HTTP_URL 取代）──
# 旧：PaddleOCR-VL 视觉 OCR 的 HTTP 端点（如 DFlash llama-server @8081）。
# OCR（PaddleOCR-VL）已退役，figure 视觉统一改走 PAPERFORGE_VISION_HTTP_URL（Qwen3-VL-4B）。
# 保留仅为向后兼容，新部署请勿设置。也接受别名 OCR_HTTP_URL。默认：未设置（None）。
# PAPERFORGE_OCR_HTTP_URL=http://127.0.0.1:8081

# ── DEPTH 校准分数偏移（ADR-011）──
# 全局分数平移量（浮点）。修正 DEPTH 相对人工盲评的系统性偏差（库内现代论文默认需 -0.09）。
# 优先级：显式本变量 > 校准集自动估计(calib_offset.json) > 0.0（关闭，向后兼容）。
# 默认：未设置（0.0 / 关闭）。⚠️ 误删此校准会让 400+ 篇评分静默漂移，详见 ADR-011。
# PAPERFORGE_DEPTH_SCORE_OFFSET=-0.09

# 是否启用「校准集自动估计」分数偏移（=1/true 启用，读取 calib_papers/runs/calib_offset.json）。
# 注意：本变量无 PAPERFORGE_ 前缀。默认：0（关闭，回退 0.0）。
# DEPTH_AUTO_OFFSET=0

# ── Qwen / VRAM 调度（ADR-008）──
# 启动即拉起 llama-server（文本 Qwen）。默认：True（1）。
# PAPERFORGE_QWEN_AUTOSTART=true
# ── 文本 llama-server 并行/投机解码调优（2026-08-05 统一）──
# 后端 llama_server_manager 统一从 .env 读取，不再硬编码。单卡 8GB 上限 PARALLEL=2。
# PAPERFORGE_LLAMA_SERVER_EXE=D:/llama-dflash-win/build-vs/bin/llama-server.exe
# PAPERFORGE_LLAMA_SERVER_MODEL=D:/Qwen3.5-9B-Q3_K_M.gguf
# PAPERFORGE_LLAMA_SERVER_DRAFT=D:/llama-b9878-bin-win-cuda-13.3-x64/qwen3.5-9b-dflash-Q5_K_M.gguf
# PAPERFORGE_LLAMA_SERVER_PARALLEL=2
# PAPERFORGE_LLAMA_SERVER_DRAFT_N_MAX=15
# 长生成（章节撰写 / 学术综述）采样温度：调低 → 草稿接受率高 → 消除投机解码掉速 + 输出可复现。
# 仅作用于 writing.py / chat.py 的 0.5 长生成路径；DEPTH/反思(0.0)、figure(0.0)、普通对话(0.3) 不受影响。默认：0.2。
# PAPERFORGE_LONG_GEN_TEMPERATURE=0.2
# OCR 与 Qwen 显存互斥（用时切换、释放对方）。8GB 卡必开。默认：True（1）。
# PAPERFORGE_VRAM_EXCLUSIVE=true

# ── 后台任务系统 ──
# 单任务最大执行时长（秒），超时自动标记失败。默认：600.0。
# PAPERFORGE_TASK_TIMEOUT=600
# 后台任务线程池大小；0 = 自动 min(4, cpu_count)。默认：0（自动）。
# PAPERFORGE_TASK_WORKERS=0

# ── LLM 行为 ──
# 批量评估时强制固定的采样温度（确定性开关，消除 run-to-run 漂移）。覆盖模型默认温度。
# 仅当调用方未显式指定 temperature 时生效。默认：未设置（使用 Provider/模型默认）。
# PAPERFORGE_LLM_TEMPERATURE=0.0
# 本地 LLM 实例（localhost/127.0.0.1）的最大并发请求数（信号量限流）。
# 仅对本地实例生效；外部托管 API 不受影响。默认：1（串行最稳定）。
# PAPERFORGE_LLM_MAX_CONCURRENCY=1
# LLM 响应缓存 backend：inprocess / redis（redis 不可用时降级到 inprocess）。默认：inprocess。
# PAPERFORGE_LLM_CACHE_BACKEND=inprocess
