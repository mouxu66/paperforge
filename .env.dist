# PaperForge 分发版默认环境变量
# 此文件用于构建分发包（PyInstaller），确保目标机器不会因绝对路径或默认启用本地 OCR 而崩溃。

# ==================== 运行时开关 ====================
# development 时才允许调用打包接口；生产环境设为 production
ENV=production

# ==================== 启动器 ====================
# 分发版已固化 web/dist，禁止启动时自动 npm install + npm run build
PAPERFORGE_NO_AUTO_REBUILD=1

# ==================== 算力模式 ====================
# 默认算力模式: speed / deep
COMPUTE_MODE=deep

# ==================== 本地 llama.cpp OCR（PaddleOCR-VL）====================
# 分发版默认禁用本地 OCR，避免目标机器缺少 GGUF 模型时静默失效或 Segfault。
# 如需启用，请将模型文件随包分发并修改以下路径为相对路径。
LLAMA_CPP_ENABLED=False
# LLAMA_CPP_OCR_MODEL_PATH=./models/PaddleOCR-VL-1.6-GGUF.gguf
# LLAMA_CPP_OCR_MMPROJ_PATH=./models/PaddleOCR-VL-1.6-GGUF-mmproj.gguf
