# =============================================================================
# PaperForge 评审严谨性开关模板（ADR-014）
#
# 用途：把「严谨性机制」从默认关闭的实验室状态点亮为生产生效。
# 机制（rubric / 证据锚定 / 硬校验 / 校准偏移）代码里早已就位，
# 但多数靠环境变量门控、默认关闭——这套开关是它们的总闸。
#
# 使用：把需要的行复制进 .env（或直接 cp .env.rigor.example .env 后按需删减）。
#       2026-08-09 已在真实 .env 中点亮以下全部开关。
# =============================================================================

# ── 1. 可复现性（P0）：同篇论文重跑分数一致 ─────────────────────────────
# 不设的话，本地 9B 模型 run-to-run 随机性高达 ±0.15（settings 实证），
# 老师昨天看到 0.72、今天重跑 0.61，分数失去可复核性。
PAPERFORGE_EVAL_SEED=42

# ── 2. GBNF 语法约束（P0）：杜绝越界分数 / JSON 解析失败 ─────────────────
# 仅当后端为本地 llama.cpp / llama-server 时可开。已默认开启（.env 已有 true）。
# 强制评分为 [0,1] 浮点、evidence_id 从证据池枚举、type/verdict 枚举，
# 从根源消灭「文本分数」「无效证据 ID 重试」「JSON 风暴」。
PAPERFORGE_DEPTH_GRAMMAR_ENABLED=true

# ── 3. 千问校准层 P7（P0）：压住 9B 模型 validates_confidence 偏松 ────────
# 5-AI 交叉验证实测：千问对「缺段报告 / 空洞反思 / 短篇」仍打 0.85+。
# 开启后 R5-R7 结构下限生效（2 段全维封顶 0.70 / reflection<100 字 ii 封顶 0.40 / 短篇封顶 0.70）。
PAPERFORGE_QWEN_CALIBRATION=1

# ── 4. 不确定门控 P2（P0）：分数带 bootstrap 95% CI ──────────────────────
# 只给点估计没有说服力。开启后每条评审附置信区间，CI 过宽 → needs_human_review。
PAPERFORGE_UNCERTAINTY_GATE=1

# ── 5. 引用真值校验 P4（P0）：查编造 / 不一致参考文献 ─────────────────────
# offline=本地一致性检查；1/true=额外接 Crossref 在线核验 DOI 真伪。
# 编造疑似 → verdict=rewrite_required（一票否决级）；不一致 → needs_evidence。
PAPERFORGE_CITATION_VERIFY=1

# ── 6. 双模型交叉复核 P8（P1，2026-08-09 新增）────────────────────────────
# 本地 Qwen 评审完后，从「模型管理」挑一个与主 provider 不同的云端模型
# 独立打分；|Δscore|≥0.15 或 verdict 不一致 → 结果标记 needs_human_review 建议。
# 未配置第二模型时静默跳过（fail-open，不影响主评审）。
PAPERFORGE_SECOND_OPINION_ENABLED=1
# 分歧阈值（可选）
# PAPERFORGE_SECOND_OPINION_THRESHOLD=0.15

# ── 6.5 全文覆盖层 P9（2026-08-09 新增）：缓解漏洞 C（ctx 只读论文头尾）─────
# 本地 9B 模型 ctx≈8K token，segment_paper_text 只给摘要/引言/结论 + 正文开头，
# 论文中段（方法/实验）几乎不可见 → QE 证据池残缺。开启后对全文做分块摘要
# （map-reduce 生成全局摘要）+ 采样中段原文注入 QE/Q234 prompt，模型在 8K ctx 内
# 「看到」全文梗概与真实段落。产物按 (paper_id, text_hash) 缓存，重评不重复付 LLM 成本。
# 默认关；全程 fail-open，任何失败自动降级为无补充（零行为变化）。
# 注意：开启会增加 ~全文长度/1500 次本地摘要调用（并行 3），首次评审变慢。
PAPERFORGE_DEPTH_FULLTEXT_ENABLED=1
# 可选：分块大小 / 注入采样块数
# PAPERFORGE_DEPTH_FULLTEXT_CHUNK_SIZE=1500
# PAPERFORGE_DEPTH_FULLTEXT_TOP_K=8

# ── 7. 可选：更严的校验（按需开启）───────────────────────────────────────
# 自洽多次采样：同一节点采样 N 次取中位数（成本 ×N，仅关键批次用）
# PAPERFORGE_CONSENSUS_ENABLED=1
# PAPERFORGE_CONSENSUS_SAMPLES=3
# 金标驱动偏移文件（指向 scripts/gold/build_peerread_gold.py 产物，缺省走内置分档表）
# PAPERFORGE_DEPTH_GOLD_OFFSET_PATH=deliverables/gold/peerread_verdict_gold.json
# 全流水线金标回归（需论文在库，回归测试用）
# PAPERFORGE_GOLD_RUN=1
