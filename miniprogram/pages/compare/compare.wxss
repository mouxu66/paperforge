.hint {
  font-size: 24rpx;
  color: #8a9099;
  margin-bottom: 18rpx;
}
.cmp {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.cmp-col {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 18rpx;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-word;
}
.cmp-head {
  font-size: 22rpx;
  color: #2b6cff;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.cmp-title {
  font-weight: 600;
  color: #1f2329;
}
.cmp-col.abstract {
  max-height: 360rpx;
  overflow: hidden;
}
.row {
  margin: 18rpx 0 6rpx;
}
.rl {
  font-size: 24rpx;
  color: #8a9099;
  font-weight: 600;
}
.pick {
  margin: 0;
  font-size: 24rpx;
}

/* 弹窗 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.dialog {
  width: 640rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
}
.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.search-bar {
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}
.search-input {
  font-size: 26rpx;
  height: 52rpx;
  line-height: 52rpx;
}
.picker-list {
  flex: 1;
  max-height: 50vh;
}
.picker-item {
  padding: 20rpx 12rpx;
  border-bottom: 1rpx solid #f0f2f5;
  font-size: 26rpx;
  line-height: 1.4;
}
.dialog-btn {
  margin: 20rpx 0 0;
}
