page {
  background: #f5f6f8;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  color: #1f2329;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #1f2329;
}

.sub {
  color: #8a9099;
  font-size: 24rpx;
  margin-top: 8rpx;
  line-height: 1.5;
}

.tag {
  display: inline-block;
  background: #eef3ff;
  color: #2b6cff;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin: 10rpx 10rpx 0 0;
}

.btn-primary {
  background: #2b6cff;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.btn-ghost {
  background: #f0f2f5;
  color: #2b6cff;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.muted {
  color: #8a9099;
}

.center {
  text-align: center;
  padding: 40rpx 0;
}

.divider {
  height: 1rpx;
  background: #eceef1;
  margin: 18rpx 0;
}

.search-bar {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 18rpx;
}

.search-input {
  font-size: 28rpx;
  height: 56rpx;
  line-height: 56rpx;
}

.cats {
  display: flex;
  margin-bottom: 18rpx;
}

.cat {
  font-size: 26rpx;
  color: #5a6068;
  padding: 8rpx 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  margin-right: 16rpx;
}

.cat-on {
  background: #2b6cff;
  color: #ffffff;
}
